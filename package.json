{
    "name": "astro-booking-system",
    "version": "1.0.2",
    "type": "module",
    "private": true,
    "scripts": {
        "websocket": "node ./js/WebSocketServer.js",
        "dev": "concurrently \"npm run websocket\" \"node dev-server.js\"",
        "build": "cross-env NODE_ENV=production node build-server.js",
        "start": "cross-env NODE_ENV=production concurrently \"npm run websocket\" \"node start-server.js\"",
        "fullstart": "npm i && npm run build && npm run start",
        "reset": "node ./js/reset.js"
    },
    "dependencies": {
        "axios": "^1.13.2",
        "concurrently": "^9.2.1",
        "cookie": "^1.1.1",
        "next": "16.1.3",
        "nodemailer": "^7.0.12",
        "prompt-sync": "^4.2.0",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "ws": "^8.19.0"
    },
    "devDependencies": {
        "cross-env": "^10.1.0",
        "eslint": "^9",
        "eslint-config-next": "16.1.3"
    }
}
